# Runtime
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
DATA_DIR=./data

# RouterAI (OpenAI-compatible API)
AI_PROVIDER=routerai
AI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_INPUT_PRICE_PER_MILLION=11
AI_OUTPUT_PRICE_PER_MILLION=45
AI_CACHE_READ_PRICE_PER_MILLION=0.23
AI_COST_CURRENCY=RUB

# Telegram bot token is used for admin polling and, when enabled, channel publishing.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to run /news management commands.
# Run /id in the bot to find your numeric ID, then add it here and restart.
TELEGRAM_ADMIN_IDS=
TELEGRAM_PUBLISHING_ENABLED=false

# Optional KontentFabrik registry integration (not required for standalone bot).
KONTENTFABRIK_DATABASE_URL=

# SQLite database
DATABASE_URL=sqlite:///./data/news_digest.sqlite3

# Collection
COLLECTION_USER_AGENT=news_digest/0.1 (+https://github.com/promologistik-art/news_digest)
COLLECTION_TIMEOUT_SECONDS=25
